# /etc/dewai/dewai.env -- rahasia backend Dew AI di server (root, chmod 600).
# Dibuat otomatis oleh setup_server.sh dari file contoh ini; edit dengan:
#   sudo nano /etc/dewai/dewai.env
# Tulis nilai TANPA tanda kutip dan tanpa spasi.

# kunci API Groq (sama dengan GROQ_API_KEY di .env laptop)
GROQ_API_KEY=

# kunci tanda tangan token login -- diisi acak otomatis saat file ini dibuat.
# Jangan disalin dari laptop / dokumen mana pun, dan jangan diubah setelah
# aplikasi dipakai (semua orang akan otomatis ter-logout).
JWT_SECRET=

# akun Admin pertama, dibuat sekali saat backend pertama kali menyala.
# Server ini bisa diakses semua orang: pakai password kuat (>= 12 karakter),
# BUKAN password yang dipakai di laptop.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAMA=Admin Dew AI

# opsional -- format <maks>/<detik>
# RATE_LIMIT_REGISTER=10/600
# RATE_LIMIT_LOGIN_GAGAL=5/900
